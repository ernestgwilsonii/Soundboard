SECRET_KEY=your-secret-key-here
DEBUG=True

# HTTPS / Traefik (Docker)
# Set DOMAIN to your real DNS name (Route 53 A record -> this server's public IP)
# to get a Let's Encrypt certificate. Leave as localhost for local development
# (Traefik serves its self-signed fallback certificate instead).
DOMAIN=localhost
LETSENCRYPT_EMAIL=you@example.com

# Email Settings (Default: Local Mailpit)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# Social Login (Optional)
# To enable Google login, provide the Client ID and Secret from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
